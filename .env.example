MCP_OPENAPI_SPEC=./examples/inventory.openapi.json
MCP_CREDENTIALS='{"Key":"replace-with-your-api-key"}'
# Optional target override; otherwise use the spec's servers.
# MCP_API_BASE_URL=https://staging.example.com/v1/
# Optional JSON arrays of HTTP methods or operation tags.
# MCP_METHODS='["get","head","options"]'
# MCP_TAGS='["inventory"]'
MCP_TRANSPORT=http
MCP_TIMEOUT_MS=10000
# Deadline for loading the entire spec graph, independently of API calls.
# MCP_SPEC_TIMEOUT_MS=10000
# External references are opt-in. Local files stay under the entry directory;
# remote references must share the entry URL's origin.
# MCP_REFERENCES_MODE=none
# MCP_MAX_REFERENCE_DOCUMENTS=128
# MCP_MAX_REFERENCE_DEPTH=64
# Default convention for explicitly declared deepObject query/form fields.
# Indexed brackets extend beyond OpenAPI's defined flat-object serialization.
# MCP_PARAMETER_PROFILE=brackets-indexed
# Set spec to restrict serialization to portable OpenAPI shapes.
PORT=3000

# Optional byte limits (received/decompressed responses and encoded requests).
# Spec bytes are shared across the root and every referenced document.
# MCP_MAX_SPEC_BYTES=33554432
# MCP_MAX_RESPONSE_BYTES=8388608
# MCP_MAX_REQUEST_BYTES=8388608

# Fixed upstream request headers, separate from credentials (JSON object).
# MCP_REQUEST_HEADERS='{"Stripe-Version":"2026-09-30.endive"}'
# Optional per-call headers added to generated tool inputs (JSON array).
# MCP_TOOL_HEADERS='["Idempotency-Key"]'
