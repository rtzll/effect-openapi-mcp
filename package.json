{
  "name": "effect-openapi-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Effect-native OpenAPI-to-MCP adapter",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "test": "vp run build && vp test",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings",
    "format:check": "vp fmt --check",
    "format": "vp fmt",
    "check": "vp check --deny-warnings && vp run test",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "demo": "vp run build && node scripts/demo.ts",
    "client:config": "node scripts/client-config.ts",
    "client:evaluate": "vp run build && node scripts/client-evaluation/run.ts",
    "example:library": "vp run build && node examples/library.ts",
    "example:recovery": "vp run build && node examples/recovery.ts",
    "example:cancellation": "vp run build && node examples/cancellation.ts",
    "compatibility": "node --expose-gc scripts/compatibility.ts",
    "benchmark": "node --expose-gc scripts/compatibility.ts --benchmark",
    "test:package": "node scripts/package-smoke.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.7",
    "effect": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "effect-openapi-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples/*.ts",
    "examples/*.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Christian Rotzoll"
}
